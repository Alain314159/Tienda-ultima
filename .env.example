# Variables de entorno para Vite (copiar a .env.local y llenar).
# NUNCA commitear .env.local: contiene la app key del proxy.

# App key que autoriza las llamadas al proxy de Telegram (Cloudflare Worker).
# En CI se inyecta como secret VITE_TG_APP_KEY de GitHub Actions.
VITE_TG_APP_KEY=

# Token de solo-lectura de GitHub (opcional) para el panel de estado:
# commits y runs de CI del repo. Sin token, esa seccion queda deshabilitada.
# scopes minimos: public_repo (o ninguno si el repo es publico y sin rate-limit).
VITE_GITHUB_TOKEN=
