{
  "appId": "com.tiendapro.app",
  "appName": "Tienda Pro",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#2196F3",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#2196F3"
    },
    "CapacitorUpdater": {
      "autoUpdate": true,
      "resetWhenUpdate": true,
      "updateUrl": "https://api.capgo.app/updates"
    }
  }
}