{
  "name": "tienda-pro",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node tests/smoke.spec.mjs",
    "smoke:local": "BASE_URL=http://localhost:4173/Tienda-ultima/ node tests/smoke.spec.mjs",
    "functional": "node tests/functional.spec.mjs",
    "functional:local": "BASE_URL=http://localhost:4173/Tienda-ultima/ node tests/functional.spec.mjs",
    "test:all": "vitest run && node tests/smoke.spec.mjs && node tests/functional.spec.mjs",
    "lint": "eslint src/ --quiet",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css}\"",
    "lint:all": "eslint src/",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "lint:css:fix": "stylelint \"src/**/*.{css,vue}\" --fix",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-updater": "8.52.1",
    "@tanstack/vue-form": "1.33.5",
    "@vueuse/core": "15.0.0",
    "chart.js": "4.5.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "dexie": "4.4.6",
    "dexie-reactive": "1.5.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "pinia": "^4.0.3",
    "reka-ui": "2.11.0",
    "vue": "3.5.43",
    "vue-router": "5.4.0",
    "vue-sonner": "2.0.9",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "dotenv": "18.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "6.2.5",
    "globals": "^17.13.0",
    "happy-dom": "21.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright-core": "1.64.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "terser": "^5.51.2",
    "vite": "8.3.4",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --fix --quiet",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
